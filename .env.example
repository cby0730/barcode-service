# Copy to .env and adjust. Precedence: CLI flags > environment > .env > defaults.
# Every setting is optional; the values below are the defaults.

# --- Server (also settable via `barcode-service serve --host/--port/--workers/--log-level`) ---
BARCODE_HOST=0.0.0.0
BARCODE_PORT=8080
# Worker processes; each loads its own copy of the models.
BARCODE_WORKERS=1
BARCODE_LOG_LEVEL=INFO

# --- Models ---
# Directory holding the ONNX files (--models-dir). Docker images set this to /app/models.
BARCODE_MODELS_DIR=models
BARCODE_DETECTOR_MODEL=yolov8s-barcode.onnx
BARCODE_UPSCALER_MODEL=pan-x2.onnx
# Backend per model: ort-cpu | openvino | ort-cuda. An unavailable backend is a startup error,
# there is no silent fallback. (--detector-backend / --upscaler-backend)
BARCODE_DETECTOR_BACKEND=ort-cpu
BARCODE_UPSCALER_BACKEND=ort-cpu
# Set to false to skip a model; decoding then relies on the remaining stages.
BARCODE_DETECTOR_ENABLED=true
BARCODE_UPSCALER_ENABLED=true

# --- Limits ---
# Maximum upload size in bytes (10 MiB).
BARCODE_MAX_IMAGE_BYTES=10485760
# Maximum decoded image size in pixels (width * height).
BARCODE_MAX_IMAGE_PIXELS=40000000
# Concurrent decode requests per worker; excess requests get 503 with Retry-After.
BARCODE_MAX_CONCURRENCY=4

# --- CORS ---
# Disabled unless you list origins explicitly (JSON list).
# BARCODE_CORS_ORIGINS=["https://app.example.com"]

# --- Docker Compose only (not read by the service) ---
# Host port published by compose.yaml; the container itself always listens on 8080.
# BARCODE_HOST_PORT=8080
